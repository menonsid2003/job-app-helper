# Docker Compose reads this file automatically (as .env, in this same
# folder) and substitutes these into docker-compose.yml's environment: block.
# Copy it first:
#   cp .env.example .env
# then edit .env — never commit real values.

# "anthropic" (Claude API — recommended, just needs a key, no local install)
# or "ollama" (free, but you need your own Ollama server reachable from this
# machine). See README.md -> "LLM provider: Ollama vs. Claude API".
LLM_PROVIDER=anthropic

# Get a key at https://console.anthropic.com. Only used when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Only used when LLM_PROVIDER=ollama. If Ollama runs on this same machine,
# http://host.docker.internal:11434 (the default in docker-compose.yml)
# already reaches it. If it runs on another machine on your LAN, point this
# at that machine's address instead, e.g. http://192.168.1.50:11434.
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b

# Optional — only needed if you turn on auto-apply's CAPTCHA-solving
# fallback. Get a key at capsolver.com. Leave blank otherwise.
CAPSOLVER_API_KEY=
