# "ollama" (local, free, current default) or "anthropic" (Claude API, paid,
# no GPU dependency). Switching back and forth only requires editing this
# line and restarting the backend — no code change.
LLM_PROVIDER=ollama

OLLAMA_HOST=http://192.168.50.6:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_MAX_RETRIES=3

# Only used when LLM_PROVIDER=anthropic. Get a key at console.anthropic.com —
# never commit a real key here. If left blank, the anthropic SDK still checks
# the ANTHROPIC_API_KEY environment variable itself, so you can also just
# export that instead of setting it here.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_MAX_RETRIES=2

DATABASE_URL=sqlite:///./data/job_app_helper.db

CRITERIA_CONFIG_PATH=criteria.yaml
BASE_RESUME_ATS_PATH=resume/base_resume.txt

# Required for auto-apply to get past a CAPTCHA-gated application form.
# Never commit a real key here — this file is a template, not real config.
CAPSOLVER_API_KEY=

CORS_ORIGINS=["http://localhost:5173"]

# ---- AI agent apply (separate, opt-in from auto-apply above) ----
# Drives a real Chrome window via the `claude` CLI + Playwright MCP instead
# of hand-coded per-ATS selectors. Requires the `claude` CLI on PATH and
# Node/npx available (Playwright MCP is fetched via npx on first use).

# Leave blank to auto-detect the system Chrome install.
AGENT_APPLY_CHROME_EXECUTABLE=

CLAUDE_CLI_PATH=claude
CLAUDE_MODEL=sonnet

# Parallel Chrome + claude instances per run. Each one costs its own Claude
# API usage concurrently — start at 1 until you've watched a full run.
AGENT_APPLY_WORKERS=1

# Visible by default (headless=false) so you can watch/intervene. Chrome
# profiles start blank — see the "open Chrome to log in" action in Settings.
AGENT_APPLY_HEADLESS=false
